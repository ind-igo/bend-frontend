import Base
import ../../src/core.bend as Core
import ../../src/frontend.bend as Frontend
import ./ir.bend as IR
import ./read.bend as Read

# Prints Bend source that restates each entry as IR and proves the two equal.
# Usage: certify.bend <contract.bend> <function>... > <contract dir>/CERT.bend

def nat(n: Nat) -> String:
  Nat.show(n) ++ "n"

def show.expr(e: IR.Expr) -> String:
  match e:
    case IR.Lit{value}:
      "IR.Lit{" ++ nat(value) ++ "}"
    case IR.Var{level}:
      "IR.Var{" ++ nat(level) ++ "}"

def show.two(name: String, left: IR.Expr, right: IR.Expr) -> String:
  l r = show.expr(left) show.expr(right)
  name ++ "{" ++ l ++ ", " ++ r ++ "}"

def show.cond(c: IR.Cond) -> String:
  match c:
    case IR.Eq{left, right}:
      show.two("IR.Eq", left, right)
    case IR.Lt{left, right}:
      show.two("IR.Lt", left, right)

def show.word(w: IR.Word) -> String:
  match w:
    case IR.SLoad{key}:
      "IR.SLoad{" ++ show.expr(key) ++ "}"
    case IR.Caller{}:
      "IR.Caller{}"
    case IR.Add{left, right}:
      show.two("IR.Add", left, right)

def show.effect(e: IR.Effect) -> String:
  match e:
    case IR.SStore{key, value}:
      show.two("IR.SStore", key, value)
    case IR.Require{c}:
      "IR.Require{" ++ show.cond(c) ++ "}"

def show.cmd(c: IR.Cmd) -> String:
  match c:
    case IR.Bind{w, level, body}:
      a b = show.word(w) show.cmd(body)
      "IR.Bind{" ++ a ++ ", " ++ nat(level) ++ ",\n    " ++ b ++ "}"
    case IR.Then{e, body}:
      a b = show.effect(e) show.cmd(body)
      "IR.Then{" ++ a ++ ",\n    " ++ b ++ "}"
    case IR.Return{value}:
      "IR.Return{" ++ show.expr(value) ++ "}"
    case IR.Tail{w}:
      "IR.Tail{" ++ show.word(w) ++ "}"
    case IR.Finish{e}:
      "IR.Finish{" ++ show.effect(e) ++ "}"
    case IR.Stop{}:
      "IR.Stop{}"

def param(+level: Nat) -> String:
  "p" ++ Nat.show(level)

def fors(levels: List<&2, Nat>) -> String:
  match levels:
    case Nil{}:
      ""
    case +level <> rest:
      "  for +" ++ param(level) ++ ": Nat\n" ++ fors(rest)

def bindings(levels: List<&2, Nat>) -> List<&2, String>:
  match levels:
    case Nil{}:
      Nil{}
    case +level <> rest:
      ("IR.Binding{" ++ nat(level) ++ ", " ++ param(level) ++ "}") <> bindings(rest)

def names(levels: List<&2, Nat>) -> List<&2, String>:
  match levels:
    case Nil{}:
      Nil{}
    case +level <> rest:
      param(level) <> names(rest)

def output(out: IR.Output) -> String & String:
  match out:
    case IR.Returns{}:
      ("IR.Returns{}", "Nat")
    case IR.Stops{}:
      ("IR.Stops{}", "Unit")

def claim.text(+name: String, +levels: List<&2, Nat>, body: IR.Cmd, kind: String & String) -> String:
  match kind:
    case Tuple{out, typ}:
      +args = String.join(names(levels), ", ")
      "def ir." ++ name ++ "() -> IR.Cmd:\n  " ++ show.cmd(body) ++ "\n\n"
        ++ "law " ++ name ++ ":\n" ++ fors(levels)
        ++ "  {IR.run(ir." ++ name ++ "(), " ++ out ++ ", [" ++ String.join(bindings(levels), ", ") ++ "])"
        ++ " == Program." ++ name ++ "(" ++ args ++ ") : Evm.Contract(" ++ typ ++ ")}\n\n"
        ++ "def " ++ name ++ "(" ++ args ++ "):\n  {==}\n\n"

def claim(+name: String, entry: Read.Entry) -> String:
  match entry:
    case Read.Entry{levels, +body}:
      claim.text(name, levels, body, output(Read.output(body)))

def claims(names: List<&2, String>, +evm: String, +decls: List<&2, Core.Declaration>) -> Result<&2, &2, String, String>:
  match names:
    case Nil{}:
      Done{""}
    case +name <> rest:
      do Result<&2, &2, String, String>:
        entry : Read.Entry <- Read.entry(evm, decls, name)
        tail : String <- claims(rest, evm, decls)
        return claim(name, entry) ++ tail

# The last path segment: everything after the final "/".
def basename.go(s: String) -> String:
  match s:
    case SNil{}:
      SNil{}
    case SCon{+c, rest}:
      Bool.pick(String, Char.is_eq(c, '/'), SNil{}, SCon{c, basename.go(rest)})

def basename(s: String) -> String:
  String.reverse(basename.go(String.reverse(s)))

def otherwise(fallback: String, value: Maybe<&2, String>) -> String:
  match value:
    case Some{s}:
      s
    case None{}:
      fallback

# evm is the Evm module's name prefix, such as "../Evm."; ir.bend sits beside it.
def header(+evm: String, file: String) -> String:
  "# Generated by backends/evm/certify.bend. Do not edit; check it with Bend.\n"
    ++ "import Base\n"
    ++ "import " ++ otherwise(evm, Read.before(".", evm)) ++ ".bend as Evm\n"
    ++ "import " ++ otherwise("", Read.before("Evm.", evm)) ++ "ir.bend as IR\n"
    ++ "import ./" ++ basename(file) ++ " as Program\n\n"

def document(+evm: String, file: String, entries: List<&2, String>, +decls: List<&2, Core.Declaration>) ->
  Result<&2, &2, String, String>:
  do Result<&2, &2, String, String>:
    body : String <- claims(entries, evm, decls)
    return header(evm, file) ++ body

def certificate(program: Core.Program, file: String, entries: List<&2, String>) -> Result<&2, &2, String, String>:
  match program entries:
    case Core.Program{_, _, _, _, _, _, _, _, +decls, _} +first <> rest:
      do Result<&2, &2, String, String>:
        evm : String <- Read.prefix(decls, first)
        document(evm, file, first <> rest, decls)
    case _ Nil{}:
      Fail{"Name at least one contract function"}

def strings(values: List<String>) -> List<&2, String>:
  match values:
    case Nil{}:
      Nil{}
    case value <> rest:
      value <> strings(rest)

def run(+file: String, entries: List<String>) -> IO(Unit):
  do IO<Unit>:
    result : Result<&2, &2, String, Core.Program> <- Frontend.check(file)
    program : Core.Program <- Frontend.or_die(Core.Program, result)
    text : String <- Frontend.or_die(String, certificate(program, file, strings(entries)))
    IO.write(text)

def args(values: List<String>) -> IO(Unit):
  match values:
    case +file <> entries:
      run(file, entries)
    case Nil{}:
      IO.die(Unit, 1, "Usage: certify.bend <contract.bend> <function>...")

def main() -> IO(Unit):
  do IO<Unit>:
    values : List<String> <- IO.args()
    args(values)
