import Base
import ../../src/core.bend as Core
import ../u32.bend as Source

# Yul's U32 fragment. Add32/Mul32 include the low-32-bit mask;
# their evaluator is a U32 model, not an interpreter for arbitrary EVM code.
type Expr is Data:
  Local{level: Nat}
  Add32{left: Expr, right: Expr}
  Mul32{left: Expr, right: Expr}
  Bind{level: Nat, value: Expr, body: Expr}

type Parameters is Data:
  Parameters{inputs: List<&2, String>, locals: List<&2, String>, checks: String,
    names: List<&2, Source.Binding<String>>, count: Nat}

def lower(expr: Source.Expr) -> Expr:
  match expr:
    case Source.Var{level}:
      Local{level}
    case Source.Add{left, right}:
      a b = lower(left) lower(right)
      Add32{a, b}
    case Source.Mul{left, right}:
      a b = lower(left) lower(right)
      Mul32{a, b}
    case Source.Let{level, value, body}:
      Bind{level, lower(value), lower(body)}

def eval(expr: Expr, +env: List<&2, Source.Binding<U32>>) -> U32:
  match expr:
    case Local{level}:
      Source.lookup(U32, env, level, 0)
    case Add32{left, right}:
      a b = eval(left, env) eval(right, env)
      U32.add(a, b)
    case Mul32{left, right}:
      a b = eval(left, env) eval(right, env)
      U32.mul(a, b)
    case Bind{level, value, body}:
      eval(body, Source.Binding{level, eval(value, env)} <> env)

# Tree paths give each local a unique name, including sibling scopes that
# reuse a source level. Independent subtrees can be printed in parallel.
def print.binary(op: String, left: String & String, right: String & String) -> String & String:
  match left right:
    case Tuple{before, a} Tuple{after, b}:
      (before ++ after, "and(" ++ op ++ "(" ++ a ++ ", " ++ b ++ "), 0xffffffff)")

def print.bind(+name: String, value: String & String, body: String & String) -> String & String:
  match value body:
    case Tuple{before, a} Tuple{after, b}:
      (before ++ "        let " ++ name ++ " := " ++ a ++ "\n" ++ after, b)

def print(expr: Expr, +path: String, +names: List<&2, Source.Binding<String>>) -> String & String:
  match expr:
    case Local{level}:
      ("", Source.lookup(String, names, level, "unbound"))
    case Add32{left, right}:
      a b = print(left, path ++ "l", names) print(right, path ++ "r", names)
      print.binary("add", a, b)
    case Mul32{left, right}:
      a b = print(left, path ++ "l", names) print(right, path ++ "r", names)
      print.binary("mul", a, b)
    case Bind{level, value, body}:
      +name = "v_" ++ path
      a b = print(value, path ++ "l", names) print(body, path ++ "r", Source.Binding{level, name} <> names)
      print.bind(name, a, b)

def parameters.cons(level: Nat, +next: Nat, rest: Parameters) -> Parameters:
  match rest:
    case Parameters{inputs, locals, checks, names, count}:
      +input = "arg" ++ Nat.show(next)
      +local = "v" ++ Nat.show(next)
      line = "      let " ++ input ++ " := calldataload(" ++ Nat.show(Nat.mul(next, 32n)) ++ ")\n"
        ++ "      if gt(" ++ input ++ ", 0xffffffff) { revert(0, 0) }\n"
      Parameters{input <> inputs, local <> locals, line ++ checks,
        Source.Binding{level, local} <> names, count}

def parameters(levels: List<&2, Nat>, +next: Nat) -> Parameters:
  match levels:
    case Nil{}:
      Parameters{Nil{}, Nil{}, "", Nil{}, next}
    case level <> tail:
      parameters.cons(level, next, parameters(tail, 1n+next))

def emit.text(inputs: List<&2, String>, locals: List<&2, String>, checks: String, count: Nat, printed: String & String) -> String:
  match printed:
    case Tuple{statements, result}:
      "// Generated by the Bend U32 lowering example.\n"
        ++ "object \"BendDemo\" {\n"
        ++ "  code {\n"
        ++ "    datacopy(0, dataoffset(\"Runtime\"), datasize(\"Runtime\"))\n"
        ++ "    return(0, datasize(\"Runtime\"))\n"
        ++ "  }\n"
        ++ "  object \"Runtime\" {\n"
        ++ "    code {\n"
        ++ "      if callvalue() { revert(0, 0) }\n"
        ++ "      if iszero(eq(calldatasize(), " ++ Nat.show(Nat.mul(count, 32n)) ++ ")) { revert(0, 0) }\n"
        ++ checks
        ++ "      mstore(0, entry(" ++ String.join(inputs, ", ") ++ "))\n"
        ++ "      return(0, 32)\n\n"
        ++ "      function entry(" ++ String.join(locals, ", ") ++ ") -> result {\n"
        ++ statements ++ "        result := " ++ result ++ "\n"
        ++ "      }\n    }\n  }\n}\n"

def emit.parts(body: Source.Expr, params: Parameters) -> String:
  match params:
    case Parameters{inputs, locals, checks, names, +count}:
      emit.text(inputs, locals, checks, count, print(lower(body), "body", names))

def emit(fn: Source.Function) -> String:
  match fn:
    case Source.Function{levels, body}:
      emit.parts(body, parameters(levels, 0n))

def compile(program: Core.Program, name: String) -> Result<&2, &2, String, String>:
  do Result<&2, &2, String, String>:
    fn : Source.Function <- Source.entry(program, name)
    return emit(fn)
